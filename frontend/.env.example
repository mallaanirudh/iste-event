# Backend origin, e.g. https://api.example.org (no /api/v1). Server-only; never exposed to the browser.
API_BASE_URL=
# Optional: backend event ID (UUID) for the Charge event page. Without it the page finds the event by SIG "Charge" and name "Power the Beacon". Server-only.
CHARGE_EVENT_ID=
# Optional legacy Tally embed configuration. Active registration links use data/registration.ts.
NEXT_PUBLIC_TALLY_FORM_ID=
# Public origin of the deployed site, e.g. https://squareone.example.org. Used for absolute link-preview (og:image) URLs. Optional on Vercel, where it is detected automatically.
SITE_URL=
