{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "noUncheckedIndexedAccess": true,

    "sourceMap": true
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "index.ts"],
  "exclude": ["node_modules", "dist"]
}